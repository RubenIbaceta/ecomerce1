NODE_ENV=development
PORT=3001
POSTGRES_DB=electronics_store
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/electronics_store
SESSION_SECRET=
# Origen exacto del frontend; también se usa para validar solicitudes de escritura.
APP_BASE_URL=http://localhost:5173
# SMTP para verificación de correo y recuperación de contraseña (Gmail personal: smtp.gmail.com:587 + contraseña de aplicación).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
SUPPORT_EMAIL=
UPLOADS_DIR=
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
WEBPAY_ENV=integration
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=
WEBPAY_RETURN_URL=http://localhost:3001/api/v1/payments/webpay/return
PAYMENT_RESERVATION_MINUTES=15
